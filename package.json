{
  "name": "entra-sharepoint-sync",
  "version": "1.0.4",
  "description": "Collaborative vault sync, per-vault sharing, 3-way merge, and version history backed by Microsoft Entra ID, SharePoint, and OneDrive.",
  "private": true,
  "scripts": {
    "dev": "esbuild src/main.ts --bundle --external:obsidian --format=cjs --watch --outfile=main.js",
    "build": "esbuild src/main.ts --bundle --external:obsidian --format=cjs --outfile=main.js",
    "test": "node --test test/*.test.mjs",
    "test:docker": "node test/docker-e2e.mjs"
  },
  "dependencies": {
    "node-diff3": "^3.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "esbuild": "^0.20.0",
    "obsidian": "latest",
    "playwright": "^1.42.0",
    "typescript": "^5.3.3"
  }
}
